  {
    "id": "fn_tambah_jadwal",
    "type": "function",
    "z": "tab_purrfeed",
    "name": "Tambah Jadwal ke Array",
    "func": "var pad = function(n){ return n < 10 ? '0'+n : ''+n; };\nvar jam   = flow.get('draft_jam');\nvar menit = flow.get('draft_menit');\nif (jam === undefined || jam === null) {\n    node.status({fill:'red',shape:'dot',text:'Jam belum diisi!'});\n    return null;\n}\nif (menit === undefined || menit === null) {\n    node.status({fill:'red',shape:'dot',text:'Menit belum diisi!'});\n    return null;\n}\nvar jadwalList = flow.get('jadwal_list') || [];\nvar duplikat = jadwalList.some(function(j){ return j.jam===jam && j.menit===menit; });\nif (duplikat) {\n    node.status({fill:'yellow',shape:'dot',text:'Jadwal '+pad(jam)+':'+pad(menit)+' sudah ada!'});\n    return null;\n}\njadwalList.push({jam:jam, menit:menit});\njadwalList.sort(function(a,b){ return (a.jam*60+a.menit)-(b.jam*60+b.menit); });\nflow.set('jadwal_list', jadwalList);\nflow.set('last_fed_menit', -1);\nvar listStr = jadwalList.map(function(j){ return pad(j.jam)+':'+pad(j.menit); }).join(' | ');\nnode.status({fill:'green',shape:'dot',text:'Ditambah. Total: '+jadwalList.length});\nreturn [{payload: listStr}];",
    "outputs": 1,
    "x": 340,
    "y": 820,
    "wires": [
      [
        "ui_text_daftar_jadwal"
      ]
    ]
  },
  {
    "id": "ui_button_hapus_jadwal",
    "type": "ui_button",
    "z": "tab_purrfeed",
    "name": "Tombol Hapus Jadwal",
    "group": "ui_group_jadwal",
    "order": 4,
    "width": 0,
    "height": 0,
    "passthru": false,
