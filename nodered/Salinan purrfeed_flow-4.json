  {
    "id": "inject_jadwal",
    "type": "inject",
    "z": "tab_purrfeed",
    "name": "Cek Jadwal (tiap 10 detik)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "10",
    "crontab": "",
    "once": true,
    "onceDelay": 0.1,
    "payload": "",
    "payloadType": "date",
    "x": 110,
    "y": 960,
    "wires": [
      [
        "fn_cek_jadwal"
      ]
    ]
  },
  {
    "id": "fn_cek_jadwal",
    "type": "function",
    "z": "tab_purrfeed",
    "name": "Cek Waktu Jadwal",
    "func": "var pad = function(n){ return n < 10 ? '0'+n : ''+n; };\nvar jadwalList = flow.get('jadwal_list') || [];\nvar now = new Date();\nvar nowJam   = now.getHours();\nvar nowMenit = now.getMinutes();\nvar nowStr   = pad(nowJam)+':'+pad(nowMenit)+':'+pad(now.getSeconds());\nvar menitKey = nowJam * 60 + nowMenit;\nvar lastFed  = flow.get('last_fed_menit');\n\nif (jadwalList.length === 0) {\n    var logMsg = '['+nowStr+'] Belum ada jadwal.';\n    node.warn(logMsg);\n    return [null, {payload: logMsg}, null];\n}\n\nvar listStr = jadwalList.map(function(j){ return pad(j.jam)+':'+pad(j.menit); }).join(' | ');\nvar match = jadwalList.some(function(j){ return j.jam===nowJam && j.menit===nowMenit; });\n\nif (!match) {\n    var logWait = '['+nowStr+'] Menunggu: '+listStr;\n    node.warn(logWait);\n    return [null, {payload: logWait}, null];\n}\n\n// Sudah waktunya \u2014 tapi sudah dijalankan di menit ini?\nif (lastFed === menitKey) {\n    var logSkip = '['+nowStr+'] Jadwal '+pad(nowJam)+':'+pad(nowMenit)+' sudah dijalankan, skip.';\n    node.warn(logSkip);\n    return [null, {payload: logSkip}, null];\n}\n\n// Sudah waktunya, belum dijalankan \u2014 cek IR\nvar irStatus = flow.get('ir_status_terakhir'); // true = Cat Detected\nif (!irStatus) {\n    var logTunggu = '['+nowStr+'] Jadwal '+pad(nowJam)+':'+pad(nowMenit)+' aktif, menunggu kucing terdeteksi...';\n    node.warn(logTunggu);\n    return [null, {payload: logTunggu}, null];\n}\n\n// IR aktif DAN waktunya cocok DAN belum dijalankan di menit ini \u2192 feed!\nflow.set('last_fed_menit', menitKey);\nvar logTrigger = '['+nowStr+'] JADWAL TERPICU + kucing terdeteksi! '+pad(nowJam)+':'+pad(nowMenit);\nnode.warn(logTrigger);\n\n// Output ke chart jadwal juga\nvar chartMsg = { payload: 1, topic: 'jadwal_terpicu' };\nreturn [{payload:'1'}, {payload: logTrigger}, chartMsg];\n",
    "outputs": 3,
    "x": 320,
    "y": 960,
    "wires": [
      [
        "mqtt_out_feed"
      ],
      [
        "debug_jadwal",
        "ui_text_jadwal_log"
      ],
      [
        "ui_chart_jadwal"
      ]
    ]
  },
