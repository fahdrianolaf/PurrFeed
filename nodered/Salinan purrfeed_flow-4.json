    ]
  },
  {
    "id": "fn_hapus_jadwal",
    "type": "function",
    "z": "tab_purrfeed",
    "name": "Hapus Jadwal dari Array",
    "func": "var pad = function(n){ return n < 10 ? '0'+n : ''+n; };\nvar jam   = flow.get('draft_jam');\nvar menit = flow.get('draft_menit');\nvar jadwalList = flow.get('jadwal_list') || [];\nvar before = jadwalList.length;\njadwalList = jadwalList.filter(function(j){ return !(j.jam===jam && j.menit===menit); });\nflow.set('jadwal_list', jadwalList);\nif (jadwalList.length === before) {\n    node.status({fill:'yellow',shape:'dot',text:'Jadwal '+pad(jam)+':'+pad(menit)+' tidak ditemukan'});\n} else {\n    node.status({fill:'green',shape:'dot',text:'Dihapus. Sisa: '+jadwalList.length});\n}\nvar listStr = jadwalList.length > 0\n    ? jadwalList.map(function(j){ return pad(j.jam)+':'+pad(j.menit); }).join(' | ')\n    : '(kosong)';\nreturn [{payload: listStr}];",
    "outputs": 1,
    "x": 340,
    "y": 880,
    "wires": [
      [
        "ui_text_daftar_jadwal"
      ]
    ]
  },
